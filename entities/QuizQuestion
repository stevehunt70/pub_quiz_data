{
  "name": "QuizQuestion",
  "type": "object",
  "properties": {
    "question_text": {
      "type": "string",
      "description": "The quiz question"
    },
    "answer": {
      "type": "string",
      "description": "The correct answer"
    },
    "artist": {
      "type": "string",
      "description": "Artist name"
    },
    "song_title": {
      "type": "string",
      "description": "Song title"
    },
    "year": {
      "type": "number",
      "description": "Year of chart entry"
    },
    "decade": {
      "type": "string",
      "enum": [
        "1950s",
        "1960s",
        "1970s",
        "1980s",
        "1990s",
        "2000s",
        "2010s",
        "2020s"
      ],
      "description": "Decade of the song"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Medium",
        "Hard"
      ],
      "description": "Question difficulty"
    },
    "peak_position": {
      "type": "number",
      "description": "Highest UK chart position"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "artist_from_song",
        "song_from_artist",
        "year_question",
        "lyrics_question",
        "one_hit_wonder",
        "connection",
        "guess_the_year",
        "intro_round"
      ],
      "description": "Type of question"
    },
    "category": {
      "type": "string",
      "description": "Optional category tag e.g. genre"
    }
  },
  "required": [
    "question_text",
    "answer",
    "difficulty"
  ]
}